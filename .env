# Empty = same domain. nginx ka "location /api/" block backend (127.0.0.1:5001)
# pe proxy karta hai, isliye calls https://omnirheuma.com/api/... pe jaati hain.
# Alag subdomain use karna ho to: VITE_API_BASE_URL=https://api.omnirheuma.com
VITE_API_BASE_URL=

# Booking form ke liye key ki zaroorat nahi - wo endpoint public hai.
VITE_API_KEY=
